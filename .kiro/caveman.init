# CAVEMAN MODE - FULL
# Token savings: ~70% vs default
# Level: FULL (máxima compresión)

MODE=full
COMPRESSION=maximal
STYLE=caveman

# Subagents comprimidos
AGENTS=cavecrew
INVESTIGATOR_MODE=compressed
BUILDER_MODE=compressed
REVIEWER_MODE=compressed

# MCPs de ahorro
SERENA_MCP=enabled
CONTEXT7_MCP=enabled

# Output rules
- Respuestas: 1-3 frases
- Sin relleno/cortesía
- Código solo si necesario
- Reviews: 1 línea max
