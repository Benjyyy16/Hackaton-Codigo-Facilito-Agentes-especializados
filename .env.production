# El frontend llama al backend directo, por su URL absoluta.
#
# Requisito: el backend solo acepta el origen definido en su FRONTEND_URL
# (app/core/security.py -> cors_origins_for, en producción sin comodín). El
# dominio de Vercel de este frontend tiene que estar ahí, o el navegador va a
# recibir "Disallowed CORS origin".
#
# Ventaja frente a proxear desde Vercel: el WebSocket /ws/events funciona, así
# que el flujo en vivo no depende del polling de respaldo.
VITE_BACKEND_URL=https://hackaton-codigo-facilito-agentes.onrender.com
