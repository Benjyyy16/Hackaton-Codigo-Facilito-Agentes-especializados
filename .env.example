# Commitment Twin - backend
# Copiar a .env y rellenar. No commitear el archivo relleno.

# --- Supabase ---
# URL del proyecto, sin barra final.
SUPABASE_URL=
# Clave de service role: uso exclusivo del servidor, nunca en una respuesta de la API.
SUPABASE_SERVICE_ROLE_KEY=
# Opcional. Reservada para el futuro flujo con JWT de usuario.
SUPABASE_ANON_KEY=

# --- Jira ---
# https://<organizacion>.atlassian.net
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
# Secreto que define este backend y que se configura en Jira al registrar el webhook.
JIRA_WEBHOOK_SECRET=

# --- Reglas de negocio ---
# Puntuación de riesgo (0-100) a partir de la cual se abre alerta.
RISK_ALERT_THRESHOLD=70

# --- Cliente HTTP ---
HTTP_TIMEOUT_SECONDS=10.0
HTTP_MAX_RETRIES=3

# --- Servicio ---
# development | staging | production | test
ENV=development
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
