# Datgent Backend — Variables de entorno
# Copiar a .env y rellenar. NUNCA commitear el archivo relleno.

# =============================================================================
# OBLIGATORIAS
# =============================================================================

# --- Supabase (almacenamiento principal) ---
# URL del proyecto, sin barra final.
SUPABASE_URL=
# Clave service role: bypass RLS, uso exclusivo del servidor.
SUPABASE_SERVICE_ROLE_KEY=

# =============================================================================
# OPCIONALES
# =============================================================================

# --- Supabase (extras) ---
# Clave anónima. Reservada para futuro flujo con JWT de usuario.
SUPABASE_ANON_KEY=
# Secreto JWT. Para validar tokens si se habilita auth de usuario.
SUPABASE_JWT_SECRET=

# --- Jira ---
# URL de la instancia: https://<org>.atlassian.net
JIRA_BASE_URL=
# Email de la cuenta de servicio Jira.
JIRA_EMAIL=
# API token de Jira (generado en id.atlassian.com).
JIRA_API_TOKEN=
# Secreto compartido del webhook (Jira NO firma con HMAC, envía este valor tal cual).
JIRA_WEBHOOK_SECRET=

# --- GitHub ---
# Personal access token con permisos de lectura.
GITHUB_TOKEN=
# Secreto HMAC-SHA256 del webhook de GitHub.
GITHUB_WEBHOOK_SECRET=
# Organización de GitHub a observar.
GITHUB_ORG=

# --- Slack ---
# Token del bot para enviar notificaciones.
SLACK_BOT_TOKEN=
# URL del incoming webhook (alternativa al bot).
SLACK_WEBHOOK_URL=
# Canal donde se publican alertas.
SLACK_CHANNEL=#alerts

# --- Vercel ---
# Token de la API de Vercel.
VERCEL_TOKEN=
# ID del equipo en Vercel.
VERCEL_TEAM_ID=

# --- Notion ---
# Token de la integración interna.
NOTION_TOKEN=
# ID de la base de datos a sincronizar.
NOTION_DATABASE_ID=

# --- OpenAI (análisis con LLM) ---
# API key de OpenAI. Sin ella los agentes devuelven análisis mock.
OPENAI_API_KEY=
# Modelo a usar (default: gpt-4o-mini).
OPENAI_MODEL=gpt-4o-mini
# Timeout por llamada al LLM en segundos (default: 30).
OPENAI_TIMEOUT_SECONDS=30

# --- OAuth Login (GitHub/Google/Notion/Slack/Vercel) ---
# URL pública del backend (para construir callbacks).
APP_BASE_URL=https://hackaton-codigo-facilito-agentes.onrender.com
# URL del frontend (CORS en producción SOLO permite este origen).
FRONTEND_URL=https://hackaton-codigo-facilito-agentes-especializados.vercel.app
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
VERCEL_CLIENT_ID=
VERCEL_CLIENT_SECRET=

# --- Reglas de negocio ---
# Score (0-100) a partir del cual se abre una alerta automática.
RISK_ALERT_THRESHOLD=70

# --- Cliente HTTP ---
# Timeout global para llamadas a APIs externas en segundos.
HTTP_TIMEOUT_SECONDS=10
# Número máximo de reintentos ante fallo transitorio.
HTTP_MAX_RETRIES=3

# --- Demo ---
# Habilitar rutas /demo/* incluso en producción (default: false).
DEMO_MODE_ENABLED=false

# --- Servicio ---
# Entorno de ejecución: development | staging | production | test
ENV=development
# Nivel de log: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
